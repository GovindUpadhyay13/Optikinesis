# ===================================================================
# OptiKinesis Environment Variables Template
# Copy this file to `.env` and fill in your actual credentials.
# ===================================================================

# Gemini API Keys (Used for Jayu Computer-Use Voice Agent & Gemma 4 AI)
GEMINI_VOICE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs Speech Synthesis (Used for high-fidelity voice confirmation & AAC speech)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Twilio Telephony Credentials (Used for emergency outbound calls and SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE=+1234567890

# Default Emergency Caregiver Phone Number
EMERGENCY_CONTACT=+1234567890
